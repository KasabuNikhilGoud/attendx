# ============================================================
# AttendX Web — environment template
# Copy → .env.local  (gitignored) and fill from Supabase
#   Project Settings → API → Project URL / anon public key
#
# Environments (see docs/environments.md):
#   attendx-test     → daily dev with fake users  (seed_test.sql)
#   attendx-staging  → release rehearsal, no users (bootstrap_admin.sql)
#   attendx-prod     → REAL users                  (never commit .env.local!)
#
# If these are empty/placeholder → the site boots in DEMO MODE
# with built-in fake data, so it runs anywhere (Codespaces OK).
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
