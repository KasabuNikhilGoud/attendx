# ============================================================
# AttendX — .env template  (copy → .env.<env> and fill keys)
# ============================================================
# Environments (see docs/environments.md):
#   .env.test        → attendx-test Supabase    (fake users, dummy data)
#   .env.staging     → attendx-staging Supabase (schema only, no users)
#   .env.production  → attendx-prod Supabase    (real users — keep out of git)
#
# Run connected to a specific environment:
#   flutter run --dart-define-from-file=.env.test
#
# Keys come from Supabase Dashboard → Project Settings → API:
#   Project URL  → SUPABASE_URL
#   anon public  → SUPABASE_ANON_KEY   (NEVER the service_role key!)
#
# Plain `flutter run` (no defines) reads the bundled `.env` asset instead.
# ============================================================
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
APP_ENV=test
